@model DashboardVm
@{ViewData["Title"]="Tổng quan";var active=Model.Loans.Where(l=>l.ReturnedAt==null).ToList();var overdue=active.Count(l=>l.DueAt<DateTime.Today);}
<div class="page-head"><div><div class="eyebrow">KHÔNG GIAN QUẢN LÝ</div><h1>Tổng quan thư viện</h1><p>Một góc nhìn đầy đủ về hoạt động thư viện hôm nay.</p></div><a class="btn primary" href="/Loans/Create">＋ Lập phiếu mượn</a></div>
<section class="welcome"><div><span class="eyebrow">MỖI NGÀY MỘT TRANG MỚI</span><h2>Tri thức được sẻ chia,<br/>giá trị được nhân lên.</h2><p>Cùng chăm sóc một không gian đọc<br/>và kết nối những người yêu sách.</p><a href="/Books">Khám phá danh mục sách <span>↗</span></a></div><div class="hero-art" aria-hidden="true"><div class="orb"></div><div class="vase">❧</div><div class="stack s1">THE ART OF READING</div><div class="stack s2">Những chân trời mới</div><div class="stack s3">LÁ LIBRARY</div><span class="spark">✦</span></div><span class="hero-number">01 / TRI THỨC</span></section>
<div class="stats"><article><span class="stat-icon green">▤</span><small>Tổng đầu sách</small><strong>@Model.Books.Count <em>đầu sách</em></strong><p>@Model.Books.Sum(b=>b.Quantity) bản sách trong thư viện</p></article><article><span class="stat-icon blue">♧</span><small>Độc giả</small><strong>@Model.Members <em>thành viên</em></strong><p>Cộng đồng bạn đọc của thư viện</p></article><article><span class="stat-icon gold">⇄</span><small>Sách đang mượn</small><strong>@active.Count <em>bản sách</em></strong><p>@Model.Books.Sum(b=>b.Available) bản sách còn sẵn</p></article><article><span class="stat-icon red">◷</span><small>Phiếu quá hạn</small><strong>@overdue <em>cần xử lý</em></strong><p><a href="/Loans?status=Quá%20hạn">Xem danh sách quá hạn →</a></p></article></div>
<div class="dashboard-grid"><section class="panel"><div class="section-head"><div><h2>Hoạt động mượn trả</h2><p>7 ngày gần nhất</p></div><span class="legend"><i></i> Mượn <i></i> Trả</span></div><div class="chart">@for(var i=6;i>=0;i--){var day=DateTime.Today.AddDays(-i);var borrow=Model.Loans.Count(l=>l.BorrowedAt.Date==day);var ret=Model.Loans.Count(l=>l.ReturnedAt?.Date==day);var max=Math.Max(1,Model.Loans.GroupBy(l=>l.BorrowedAt.Date).Max(g=>g.Count()));<div class="chart-day"><div class="bars"><div title="@borrow lượt mượn" style="height:@(Math.Max(3,borrow*110/max))px"><span>@borrow</span></div><div title="@ret lượt trả" style="height:@(Math.Max(3,ret*110/max))px"><span>@ret</span></div></div><small>@day.ToString("dd/MM")</small></div>}</div></section><section class="panel"><div class="section-head"><div><h2>Phân bố đầu sách</h2><p>Theo thể loại</p></div><span>◉</span></div><div class="categories">@foreach(var g in Model.Books.GroupBy(b=>b.Category).OrderByDescending(g=>g.Count()).Take(5)){<div><span>@g.Key</span><b>@g.Count()</b><div class="track"><i style="width:@(g.Count()*100/Model.Books.Count)%"></i></div></div>}</div></section></div>
<section class="panel"><div class="section-head"><div><h2>Phiếu mượn gần đây</h2><p>Theo dõi những lượt lưu thông mới nhất</p></div><a class="text-link" href="/Loans">Xem tất cả →</a></div><div class="table-wrap"><table><thead><tr><th>MÃ PHIẾU</th><th>SÁCH</th><th>ĐỘC GIẢ</th><th>HẠN TRẢ</th><th>TRẠNG THÁI</th></tr></thead><tbody>@foreach(var l in Model.Loans.OrderByDescending(l=>l.Id).Take(5)){<tr><td class="muted">PM@(l.Id.ToString("0000"))</td><td><a href="/Books/Details/@l.BookId"><b>@l.Book.Title</b></a></td><td>@l.Member.FullName</td><td>@l.DueAt.ToString("dd/MM/yyyy")</td><td><span class="badge @(l.Status=="Quá hạn"?"danger":l.Status=="Đã trả"?"neutral":"")">@l.Status</span></td></tr>}</tbody></table></div></section>
