@model List<Member>
@{ViewData["Title"]="Quản lý độc giả";var q=Context.Request.Query;}
<div class="page-head"><div><div class="eyebrow">CỘNG ĐỒNG BẠN ĐỌC</div><h1>Quản lý độc giả</h1><p>Quản lý thông tin thành viên và hiệu lực thẻ thư viện.</p></div><a class="btn primary" href="/Members/Edit">＋ Thêm độc giả</a></div><form method="get" class="filters panel"><div class="search"><span>⌕</span><input name="q" value="@q["q"]" placeholder="Tìm tên, email hoặc mã độc giả…" aria-label="Tìm độc giả"/></div><select name="status" aria-label="Trạng thái thẻ"><option value="">Tất cả trạng thái</option><option value="active" selected="@(q["status"]=="active")">Đang hoạt động</option><option value="inactive" selected="@(q["status"]=="inactive")">Khóa / hết hạn</option></select><button class="btn primary">Tìm kiếm</button></form><section class="panel"><div class="section-head"><h2>Danh sách độc giả <span class="count">@Model.Count</span></h2></div><div class="table-wrap"><table><thead><tr><th>ĐỘC GIẢ</th><th>LIÊN HỆ</th><th>LOẠI THẺ</th><th>HẾT HẠN</th><th>ĐANG MƯỢN</th><th>TRẠNG THÁI</th><th>THAO TÁC</th></tr></thead><tbody>@foreach(var m in Model){<tr><td><b>@m.FullName</b><small>DG@(m.Id.ToString("0000"))</small></td><td>@m.Email<small>@m.Phone</small></td><td>@m.Type</td><td>@m.ExpiresAt.ToString("dd/MM/yyyy")</td><td>@m.Loans.Count(l=>l.ReturnedAt==null) cuốn</td><td><span class="badge @(!m.Active||m.ExpiresAt<DateTime.Today?"danger":"")">@(!m.Active?"Đã khóa":m.ExpiresAt<DateTime.Today?"Hết hạn":"Hoạt động")</span></td><td><div class="actions"><a class="text-link" href="/Members/Edit/@m.Id">Sửa</a><form asp-action="Delete" asp-route-id="@m.Id" method="post" data-confirm="Xóa độc giả này?"><button class="text-button danger-text">Xóa</button></form></div></td></tr>}</tbody></table>@if(Model.Count==0){<div class="empty">Không tìm thấy độc giả phù hợp.</div>}</div></section>
