@model Member
@{ViewData["Title"]=Model.Id==0?"Thêm độc giả":"Cập nhật độc giả";}
<a class="back" href="/Members">← Danh sách độc giả</a><div class="page-head"><h1>@ViewData["Title"]</h1></div><form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel form-panel"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><label>Họ và tên *<input asp-for="FullName" required/></label><label>Email *<input asp-for="Email" required/></label><label>Số điện thoại<input asp-for="Phone"/></label><label>Loại độc giả<select asp-for="Type"><option>Sinh viên</option><option>Học sinh</option><option>Giáo viên</option><option>Khác</option></select></label><label>Ngày hết hạn thẻ<input asp-for="ExpiresAt" type="date" required/></label><label class="checkbox"><input asp-for="Active"/> Thẻ đang hoạt động</label></div><div class="form-actions"><a class="btn" href="/Members">Hủy bỏ</a><button class="btn primary">Lưu độc giả</button></div></form>
