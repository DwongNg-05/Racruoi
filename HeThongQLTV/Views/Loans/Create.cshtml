@{ViewData["Title"]="Lập phiếu mượn";}
<a class="back" href="/Loans">← Danh sách phiếu mượn</a><div class="page-head"><div><h1>Lập phiếu mượn</h1><p>Chọn độc giả và sách. Hệ thống sẽ kiểm tra điều kiện trước khi lập phiếu.</p></div></div><form asp-action="Create" method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation"></div><label>Độc giả *<select name="memberId" required><option value="">Chọn độc giả</option>@foreach(Member m in ViewBag.Members){<option value="@m.Id">DG@(m.Id.ToString("0000")) — @m.FullName</option>}</select></label><label>Sách cần mượn *<select name="bookId" required><option value="">Chọn sách</option>@foreach(Book b in ViewBag.Books){<option value="@b.Id">@b.Title — còn @b.Available bản</option>}</select></label><p class="hint">Thẻ cần còn hiệu lực, không nợ phạt và chưa vượt giới hạn mượn. Sách có hàng đặt trước được ưu tiên theo thứ tự đăng ký.</p><div class="form-actions"><a class="btn" href="/Loans">Hủy bỏ</a><button class="btn primary">Xác nhận mượn sách</button></div></form>
