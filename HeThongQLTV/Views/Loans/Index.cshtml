@model List<Loan>
@{ViewData["Title"]="Mượn & trả sách";var staff=!User.IsInRole("DocGia");var q=Context.Request.Query;}
<div class="page-head"><div><div class="eyebrow">LƯU THÔNG SÁCH</div><h1>@(staff?"Mượn & trả sách":"Lịch sử mượn của tôi")</h1><p>Theo dõi phiếu mượn, thời hạn và các khoản phạt.</p></div>@if(staff){<a class="btn primary" href="/Loans/Create">＋ Lập phiếu mượn</a>}</div><form class="filters panel" method="get"><div class="search"><span>⌕</span><input name="q" value="@q["q"]" placeholder="Tìm mã phiếu, tên sách, độc giả…" aria-label="Tìm phiếu mượn"/></div><select name="status" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option>@foreach(var s in new[]{"Đang mượn","Quá hạn","Đã trả"}){<option selected="@(q["status"]==s)">@s</option>}</select><button class="btn primary">Tìm kiếm</button><a class="reset" href="/Loans">Đặt lại</a></form><section class="panel"><div class="section-head"><h2>Danh sách phiếu <span class="count">@Model.Count</span></h2></div><div class="table-wrap"><table><thead><tr><th>PHIẾU / ĐỘC GIẢ</th><th>SÁCH</th><th>NGÀY MƯỢN</th><th>HẠN TRẢ</th><th>TRẠNG THÁI</th><th>TIỀN PHẠT</th><th>THAO TÁC</th></tr></thead><tbody>@foreach(var l in Model){<tr><td><b>PM@(l.Id.ToString("0000"))</b><small>@l.Member.FullName</small></td><td class="title-cell"><a href="/Books/Details/@l.BookId">@l.Book.Title</a><small>Gia hạn: @l.Renewals lần</small></td><td>@l.BorrowedAt.ToString("dd/MM/yyyy")</td><td>@l.DueAt.ToString("dd/MM/yyyy")</td><td><span class="badge @(l.Status=="Quá hạn"?"danger":l.Status=="Đã trả"?"neutral":"")">@l.Status</span>@if(l.ReturnedAt!=null){<small>@l.ReturnedAt.Value.ToString("dd/MM/yyyy")</small>}</td><td>@l.Fine.ToString("N0") đ @if(l.Fine>0){<small>@(l.FinePaid?"Đã thu":"Chưa thanh toán")</small>}</td><td><div class="actions wrap">@if(l.ReturnedAt==null){@if(staff){<form asp-action="Return" asp-route-id="@l.Id" method="post" data-confirm="Xác nhận đã nhận lại sách từ độc giả?"><button class="mini-btn">Trả sách</button></form>}<form asp-action="Renew" asp-route-id="@l.Id" method="post"><button class="text-button">Gia hạn</button></form>}@if(staff&&l.Fine>0&&!l.FinePaid){<form asp-action="Pay" asp-route-id="@l.Id" method="post" data-confirm="Xác nhận đã thu đủ khoản phạt này?"><button class="mini-btn">Thu phạt</button></form>}</div></td></tr>}</tbody></table>@if(Model.Count==0){<div class="empty">Chưa có phiếu mượn phù hợp.</div>}</div></section>
