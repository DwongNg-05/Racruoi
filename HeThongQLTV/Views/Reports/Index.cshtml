@model DashboardVm
@{ViewData["Title"]="Thống kê & báo cáo";var q=Context.Request.Query;}
<div class="page-head"><div><div class="eyebrow">DỮ LIỆU & GÓC NHÌN</div><h1>Thống kê & báo cáo</h1><p>Tổng hợp hoạt động thư viện theo thời gian mượn sách.</p></div><a class="btn" asp-action="Export" asp-route-kind="books">↓ Xuất danh mục CSV</a></div><form class="filters panel" method="get"><label>Từ ngày<input type="date" name="from" value="@q["from"]"/></label><label>Đến ngày<input type="date" name="to" value="@q["to"]"/></label><button class="btn primary">Xem báo cáo</button><a class="btn" asp-action="Export" asp-route-from="@q["from"]" asp-route-to="@q["to"]">↓ Xuất phiếu CSV</a></form><div asp-validation-summary="All" class="validation"></div><div class="stats"><article><small>Lượt mượn trong kỳ</small><strong>@Model.Loans.Count</strong><p>Theo ngày lập phiếu</p></article><article><small>Đã trả trong nhóm phiếu</small><strong>@Model.Loans.Count(l=>l.ReturnedAt!=null)</strong><p>Các phiếu thuộc kỳ đã chọn</p></article><article><small>Đang quá hạn</small><strong>@Model.Loans.Count(l=>l.Status=="Quá hạn")</strong><p>Cần nhắc độc giả trả sách</p></article><article><small>Tiền phạt đã thu</small><strong class="money">@Model.Loans.Where(l=>l.FinePaid).Sum(l=>l.Fine).ToString("N0") <em>đ</em></strong><p>Theo nhóm phiếu trong kỳ</p></article></div><div class="dashboard-grid"><section class="panel"><div class="section-head"><h2>Sách được mượn nhiều</h2></div><div class="ranking">@foreach(var g in Model.Loans.GroupBy(l=>l.Book).OrderByDescending(g=>g.Count()).Take(5)){<div><span class="rank-icon">▤</span><span><b>@g.Key.Title</b><small>@g.Key.Author</small></span><strong>@g.Count() <small>lượt</small></strong></div>}@if(Model.Loans.Count==0){<p>Chưa có dữ liệu trong kỳ.</p>}</div></section><section class="panel"><div class="section-head"><h2>Độc giả tích cực</h2></div><div class="ranking">@foreach(var g in Model.Loans.GroupBy(l=>l.Member).OrderByDescending(g=>g.Count()).Take(5)){<div><span class="avatar">@g.Key.FullName.Substring(0,1)</span><span><b>@g.Key.FullName</b><small>DG@(g.Key.Id.ToString("0000"))</small></span><strong>@g.Count() <small>lượt</small></strong></div>}</div></section></div>
