@model List<Reservation>
@{ViewData["Title"]="Đặt trước sách";}
<div class="page-head"><div><div class="eyebrow">HẸN VỚI MỘT CUỐN SÁCH</div><h1>Đặt trước sách</h1><p>Hàng chờ được phục vụ theo thứ tự đăng ký khi sách được trả lại.</p></div><a class="btn" href="/Books">Xem danh mục →</a></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>MÃ</th><th>SÁCH</th><th>ĐỘC GIẢ</th><th>NGÀY ĐẶT</th><th>TRẠNG THÁI</th><th>THAO TÁC</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>DT@(r.Id.ToString("0000"))</td><td><b>@r.Book.Title</b><small>@(r.Book.Available>0?"Đã có sách trả về":"Đang chờ sách trả")</small></td><td>@r.Member.FullName</td><td>@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td><span class="badge @(r.Status=="Đang chờ"?"":"neutral")">@r.Status</span></td><td>@if(r.Status=="Đang chờ"){<form asp-action="Cancel" asp-route-id="@r.Id" method="post" data-confirm="Hủy yêu cầu đặt trước này?"><button class="text-button danger-text">Hủy đặt trước</button></form>}</td></tr>}</tbody></table>@if(Model.Count==0){<div class="empty"><span class="empty-icon">◷</span><h2>Chưa có yêu cầu đặt trước</h2><p>Bạn có thể đặt trước tại trang chi tiết những sách đã hết bản sẵn có.</p></div>}</div></section>
