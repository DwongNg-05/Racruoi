@model UserInput
@{ViewData["Title"]=Model.Id==0?"Thêm tài khoản":"Cập nhật tài khoản";}
<a class="back" href="/Users">← Danh sách tài khoản</a><div class="page-head"><h1>@ViewData["Title"]</h1></div><form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel form-panel"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><label>Họ tên *<input asp-for="FullName" required/></label><label>Tên đăng nhập *<input asp-for="Username" required/></label><label>Mật khẩu @(Model.Id>0?"(để trống nếu giữ nguyên)":"*")<input asp-for="Password" type="password" minlength="8" autocomplete="new-password"/></label><label>Vai trò<select asp-for="Role"><option value="Admin">Quản trị viên</option><option value="ThuThu">Thủ thư</option><option value="DocGia">Độc giả</option></select></label><label>Liên kết thẻ (bắt buộc với độc giả)<select asp-for="MemberId"><option value="">Không liên kết</option>@foreach(Member m in ViewBag.Members){<option value="@m.Id">@m.FullName — DG@(m.Id.ToString("0000"))</option>}</select></label><label class="checkbox"><input asp-for="Active"/> Tài khoản hoạt động</label></div><div class="form-actions"><a class="btn" href="/Users">Hủy bỏ</a><button class="btn primary">Lưu tài khoản</button></div></form>
