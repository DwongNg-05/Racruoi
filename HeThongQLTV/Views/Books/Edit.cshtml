@model Book
@{ViewData["Title"]=Model.Id==0?"Thêm sách mới":"Chỉnh sửa sách";}
<a class="back" href="/Books">← Danh mục sách</a><div class="page-head"><div><h1>@ViewData["Title"]</h1><p>Thông tin chính xác giúp độc giả tìm được cuốn sách cần thiết.</p></div></div><form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel form-panel"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><label>Tên sách *<input asp-for="Title" required/></label><label>Tác giả *<input asp-for="Author" required/></label><label>Thể loại *<input asp-for="Category" required list="genres"/><datalist id="genres"><option>Văn học</option><option>Công nghệ</option><option>Kỹ năng sống</option><option>Khoa học</option><option>Lịch sử</option></datalist></label><label>Nhà xuất bản<input asp-for="Publisher"/></label><label>ISBN<input asp-for="Isbn"/></label><label>Năm xuất bản<input asp-for="Year" min="1" max="2100"/></label><label>Tổng số bản<input asp-for="Quantity" min="0" max="10000"/></label><label>Vị trí kệ<input asp-for="Shelf"/></label><label class="full">Giới thiệu sách<textarea asp-for="Description" rows="5"></textarea></label></div><div class="form-actions"><a class="btn" href="/Books">Hủy bỏ</a><button class="btn primary">Lưu thông tin</button></div></form>
