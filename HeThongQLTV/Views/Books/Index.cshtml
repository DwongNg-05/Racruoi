@model List<Book>
@{ViewData["Title"]="Danh mục sách";bool staff=!User.IsInRole("DocGia");var q=Context.Request.Query;}
<div class="page-head"><div><div class="eyebrow">KHO TRI THỨC</div><h1>Danh mục sách</h1><p>Tìm cuốn sách phù hợp cho hành trình khám phá của bạn.</p></div>@if(staff){<a class="btn primary" href="/Books/Edit">＋ Thêm sách mới</a>}</div>
<form class="filters panel" method="get"><div class="search"><span>⌕</span><input name="q" value="@q["q"]" placeholder="Tìm tên sách, tác giả, ISBN…" aria-label="Tìm sách"/></div><select name="category" aria-label="Thể loại"><option value="">Tất cả thể loại</option>@foreach(string c in ViewBag.Categories){<option value="@c" selected="@(q["category"]==c)">@c</option>}</select><select name="availability" aria-label="Tình trạng"><option value="">Tất cả tình trạng</option><option value="available" selected="@(q["availability"]=="available")">Còn sẵn</option><option value="out" selected="@(q["availability"]=="out")">Đã hết</option></select><select name="sort" aria-label="Sắp xếp"><option value="">Tên sách A–Z</option><option value="new" selected="@(q["sort"]=="new")">Mới thêm</option><option value="quantity" selected="@(q["sort"]=="quantity")">Số bản còn giảm dần</option></select><button class="btn primary">Tìm kiếm</button><a class="reset" href="/Books">Đặt lại</a></form>
<div class="list-meta"><span>Tìm thấy <b>@ViewBag.Total</b> đầu sách</span><span>▦ Danh mục thư viện</span></div><div class="book-grid">@foreach(var b in Model){<article class="book-card"><a class="cover-area" href="/Books/Details/@b.Id"><div class="book-cover" style="--cover:@b.Color"><small>@b.Author</small><strong>@b.Title</strong><span>✦</span><em>LÁ LIBRARY</em></div></a><div class="book-info"><span class="category">@b.Category</span><a href="/Books/Details/@b.Id"><h3>@b.Title</h3></a><p>@b.Author</p><div class="book-bottom"><span class="badge @(b.Available==0?"danger":"")">@(b.Available>0?$"Còn {b.Available}/{b.Quantity} bản":"Hết sách")</span><a href="/Books/Details/@b.Id" aria-label="Xem @b.Title">↗</a></div></div></article>}</div>
@if(Model.Count==0){<div class="empty panel"><h2>Chưa tìm thấy sách phù hợp</h2><p>Thử từ khóa khác hoặc bỏ bớt bộ lọc.</p></div>}
<div class="pagination"><span>Trang @ViewBag.Page / @ViewBag.Pages</span>@for(var i=1;i<=(int)ViewBag.Pages;i++){<a class="@(i==(int)ViewBag.Page?"current":"")" asp-action="Index" asp-route-page="@i" asp-route-q="@q["q"]" asp-route-category="@q["category"]" asp-route-availability="@q["availability"]" asp-route-sort="@q["sort"]">@i</a>}</div>
